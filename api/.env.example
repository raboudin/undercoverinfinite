# Copy to .env and adjust as needed.
# Matches the default credentials in the root docker-compose.yml `postgres` service.
DATABASE_URL="postgresql://undercoverinfinite:undercoverinfinite@localhost:5432/undercoverinfinite?schema=public"

# In dev the Nuxt frontend already occupies :3000, so the API moves to :3001.
# (Containers keep the default 3000 — compose/Traefik point at that port.)
PORT=3001

# Origines autorisées à appeler l'API, séparées par des virgules. Obligatoire
# dès qu'un front est déployé : l'auth par cookies interdit le joker `*`.
# Défaut si vide : http://localhost:3000
CORS_ORIGINS="http://localhost:3000"

# LLM qui génère les paires de mots, à la demande.
#
# N'importe quel endpoint compatible OpenAI (`POST /chat/completions`, clé en
# `Authorization: Bearer`) convient — mais la clé, le modèle et l'URL doivent
# venir du **même** fournisseur. Une clé Google envoyée au gateway Vercel
# répond 401 : c'est l'erreur classique, et elle remonte en 503 côté jeu.
LLM_API_KEY=""

# --- Option A : Vercel AI Gateway (défaut du code, clé `vck_…`) -------------
# Les identifiants de modèle sont préfixés du fournisseur.
# LLM_MODEL="google/gemini-3.5-flash-lite"
# LLM_GATEWAY_URL="https://ai-gateway.vercel.sh/v1/chat/completions"

# --- Option B : Google AI Studio en direct (clé Gemini) ---------------------
# Identifiants de modèle **sans** préfixe fournisseur. `gemini-flash-lite-latest`
# suit la dernière lite en date ; les versions pinnées (2.5-lite…) finissent par
# être fermées aux nouveaux comptes et répondent alors 404.
# LLM_MODEL="gemini-flash-lite-latest"
# LLM_GATEWAY_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"

# Modèles disponibles pour ta clé Google :
#   curl -s -H "x-goog-api-key: $LLM_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
#
# `.env` n'est relu qu'au démarrage : après toute modification ici, redémarre
# l'API (`nest --watch` ne surveille que les fichiers TS).

# --- Authentification -------------------------------------------------------
# Secret de signature des access tokens. Obligatoire en production (l'API
# refuse de démarrer sans) ; hors production, un secret aléatoire est généré à
# chaque boot — pratique, mais toutes les sessions sautent au redémarrage.
#   openssl rand -hex 32
AUTH_JWT_SECRET=""

# Durées de vie. Format : 45s / 30m / 5h / 30d, ou un entier = secondes.
# AUTH_ACCESS_TOKEN_TTL="5h"
# AUTH_REFRESH_TOKEN_TTL="30d"

# Cookies. `strict` suffit tant que le front et l'API partagent le même domaine
# enregistrable (localhost en dev, *.undercoverinfinite.com en déploiement) ;
# passer à `lax`, voire `none`, seulement si le front vit sur un autre domaine
# — `none` implique HTTPS des deux côtés.
# AUTH_COOKIE_SAME_SITE="strict"
# `true` en production par défaut ; à forcer ici pour tester en HTTPS local.
# AUTH_COOKIE_SECURE="false"
# Utile uniquement pour partager le cookie entre sous-domaines.
# AUTH_COOKIE_DOMAIN=".undercoverinfinite.com"

# Où renvoyer le navigateur après un aller-retour OAuth. L'échec ajoute
# `?error=oauth_rejected` à l'URL ci-dessous, que la page /connexion du front
# sait traduire en message lisible.
# AUTH_OAUTH_SUCCESS_REDIRECT="http://localhost:3000"
# AUTH_OAUTH_FAILURE_REDIRECT="http://localhost:3000/connexion"

# URL publique de l'API, utilisée pour construire les callbacks OAuth par
# défaut (`<AUTH_API_URL>/auth/google/callback`).
# AUTH_API_URL="http://localhost:3001"

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Laisser vide désactive proprement /auth/google (503), sans empêcher l'API de
# démarrer. L'URL de callback doit être déclarée à l'identique côté console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# OAuth Facebook — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# FACEBOOK_CALLBACK_URL="http://localhost:3001/auth/facebook/callback"
